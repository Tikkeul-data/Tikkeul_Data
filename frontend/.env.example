# 복사해서 .env 로 사용 (.env 는 Git 에 올리지 않는다)
# EXPO_PUBLIC_ 접두사 변수는 웹 번들에 그대로 포함된다. 비밀키·토큰을 넣지 않는다.
# 웹 개발: http://localhost:8000
# 이 값을 비워 두면(줄을 지우면) 개발 중 네이티브는 Expo 개발 서버 주소의 PC 를 자동으로 쓴다.
# 휴대폰 실기기는 PC 의 LAN 주소를 직접 적는다(예: http://192.168.0.5:8000). 안드로이드 에뮬레이터는 http://10.0.2.2:8000
# 운영(Vercel·스토어 앱)은 반드시 HTTPS 주소여야 한다(웹 혼합 콘텐츠, iOS ATS, Android 기본 설정이 HTTP 를 막는다).
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_KAKAO_JS_KEY=

# Android/iOS 공식 길찾기 SDK with UI용 네이티브 앱 키.
# 카카오디벨로퍼스에서 com.tikkeuldata.app 플랫폼 등록 후 설정한다.
# JavaScript 키/REST 키와 다르다. EXPO_PUBLIC_ 접두사를 붙이지 않는다.
# 설정 후 네이티브 앱을 다시 빌드해야 적용된다. Expo Go/브라우저에서는 실행되지 않는다.
KAKAO_NAVI_NATIVE_APP_KEY=
